# ─── Repo Trust environment example ──────────────────────────────────
# Copy this file to .env (or set these in your shell). The CLI reads
# env vars in the REPO_TRUST_* namespace and a few well-known external
# names like GITHUB_TOKEN.
#
# This file MUST stay safe to commit — only example/dummy values here.

# GitHub Personal Access Token (read-only is enough for public repos).
# Without it, the CLI falls back to unauthenticated requests with much
# stricter rate limits (60 requests/hour vs 5,000/hour authenticated).
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: where Repo Trust stores its local cache and reports.
# Defaults to ~/.repo-trust/ on Linux/macOS and %APPDATA%\repo-trust on Windows.
# REPO_TRUST_CACHE_DIR=~/.repo-trust
# REPO_TRUST_REPORTS_DIR=./repo-trust-reports

# Optional: log level. Standard tracing filter syntax.
# Examples: "info", "debug", "repo_trust=debug,octocrab=warn".
# RUST_LOG=info

# Optional: pin a scoring version. If unset, latest is used.
# REPO_TRUST_SCORING_VERSION=1.0.0

# Optional: path to a TOML file with custom module weights.
# REPO_TRUST_WEIGHTS=./weights.toml

# Optional: deps.dev API base URL (override only for testing).
# REPO_TRUST_DEPS_DEV_URL=https://api.deps.dev

# Optional: scorecard.dev API base URL (override only for testing).
# REPO_TRUST_SCORECARD_URL=https://api.scorecard.dev

# Optional: OSV API base URL (override only for testing).
# REPO_TRUST_OSV_URL=https://api.osv.dev

# ─── MemPalace (developer tool, not shipped binary) ──────────────────
# Used only for local AI-assisted development with Claude Code.
# Runs Python; not required to use repo-trust as an end-user.
# MEMPALACE_HOME=~/.mempalace
