# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local.
#
# Variables prefixed with VITE_ / NEXT_PUBLIC_ / EXPO_PUBLIC_ etc. are exposed
# to the browser. Anything sensitive must NOT use those prefixes.
#
# Project-specific variables go below. The variables here are illustrative;
# adapt to this project's actual stack.

# --- App basics ---
# APP_ENV=development
# APP_URL=http://localhost:3000

# --- Supabase (if used) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=    # server-side only, never expose to browser

# --- LLM providers (if used) ---
# OPENAI_API_KEY=               # server-side only
# ANTHROPIC_API_KEY=            # server-side only

# --- Observability (if used) ---
# VITE_SENTRY_DSN=
# BRAINTRUST_API_KEY=

# --- Other integrations (add as needed) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RETELL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
