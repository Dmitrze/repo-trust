# Rust
target/
**/*.rs.bk
*.pdb

# Cargo - we commit Cargo.lock for binary crates (which this is)
# so it stays tracked. If we ever extract a library crate, gitignore .lock there.

# Python (MemPalace local memory layer)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# Project-local Repo Trust artifacts
.repo-trust/
repo-trust-reports/
*.cache.db
*.cache.db-journal
*.cache.db-wal
*.cache.db-shm

# MemPalace local memory (NEVER commit)
.mempalace/

# Environment / secrets (NEVER commit)
.env
.env.local
.env.*.local
secrets.toml
*.pem
*.key

# Editors / IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Logs / temp
*.log
*.pid
*.seed
*.pid.lock
.cache/
.temp/
.tmp/
logs/

# Coverage / profiling
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
lcov.info

# Docs build
docs/_build/
site/

# Release artifacts
dist/
*.tar.gz
*.zip

# OpenClaw private operator notes (NEVER push)
.openclaw/
.openclaw-private/
SOUL.local.md

# Inherited from template (just in case downstream tooling appears)
node_modules/
.next/
.turbo/
